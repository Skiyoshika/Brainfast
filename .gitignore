# IdleBrain root repo ignore rules

# Git worktrees (isolated dev workspaces)
.worktrees/

# Large local data
Samples/
data/
outputs/
*.nrrd
project/data/
project/outputs/

# External dependency repo (already has its own git)
repos/

# Python cache / env
**/__pycache__/
*.pyc
.venv/
venv/

# Frontend build artifacts
project/frontend/build/
project/frontend/dist/

# Agentic workspace / brainstorm artifacts
.superpowers/

# Runtime-mutable learned artifacts — shared-state layout lives under
# project/outputs/ (already ignored). These specific legacy paths can
# also accumulate runtime data before migration, so ignore them too.
project/train_data_set/class_priors/
project/cellpose_training/

# OS/editor artifacts
.DS_Store
Thumbs.db
.vscode/
.claude/
