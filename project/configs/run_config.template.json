{
  "project": {"name": "brainfast", "version": "mvp-1.0"},
  "input": {
    "slice_dir": "data/raw_slices",
    "slice_glob": "*.tif",
    "sampling_mode": "merge5",
    "slice_interval_n": 5,
    "pixel_size_um_xy": 0.65,
    "slice_spacing_um": 25.0,
    "bit_depth": 16,
    "channel_map": {"red": 0, "green": 1, "farred": 2},
    "active_channel": "red",
    "slicing_plane": "coronal"
  },
  "target": {
    "marker": "unspecified",
    "signal_type": "cyto"
  },
  "compute": {
    "device": "auto"
  },
  "registration": {
    "mode": "2d_slice_with_3d_smoothness",
    "scope": "whole",
    "whole_brain_backend": "miki_3d",
    "truth_source": "3d_registered_volume",
    "template_path": "configs/allen_ref_cache/average_template_25.nii.gz",
    "annotation_path": "annotation_25.nii.gz",
    "atlas_hemisphere": "left",
    "ants_transform": "SyN",
    "ml_flip": false,
    "random_seed": 42,
    "skip_laplacian_refinement": true,
    "laplacian_lambda": 0.18,
    "laplacian_maxiter": 100,
    "auto_first": true,
    "fail_score_threshold": 0.65,
    "landmark_fallback": true,
    "landmark_max_slices": 5,
    "atlas_z_range": [0, 528],
    "atlas_z_from_filename": false,
    "atlas_z_z_scale": 1.0,
    "atlas_z_offset": 0,
    "atlas_z_refine_range": 10,
    "tissue_shrink_factor": 1.0,
    "display_gamma": 0.65,
    "ap_method": "autopick",
    "deepslice_max_deviation": 25,
    "enable_silhouette_conform": true,
    "contour_max_disp_ratio": 0.20,
    "contour_tps_smooth": 2.0,
    "contour_n_pts": 96,
    "enable_sitk_ref_refine": false,
    "sitk_max_dim": 512,
    "sitk_mi_bins": 32,
    "sitk_max_iter": 60,
    "sitk_mesh_size": 8,
    "sitk_max_disp_frac": 0.10
  },
  "detection": {
    "mode": "cellpose",
    "reporter_intensity_threshold_pct": 95.0,
    "reporter_min_area_px": 8.0,
    "reporter_max_area_px": 2000.0,
    "marker_channel": "",
    "marker_intensity_threshold_pct": 95.0,
    "primary_model": "cpsam",
    "secondary_model": "none",
    "merge_primary_secondary": false,
    "cellpose_gpu": true,
    "cellpose_diameter_um": 12.0,
    "cellpose_channels": [0, 0],
    "cellpose_flow_threshold": 0.4,
    "cellpose_cellprob_threshold": 0.0,
    "cellpose_min_size_px": 8,
    "within_slice_dedup_px": 4.0,
    "fallback_model": "log",
    "fallback_log_min_sigma": 1.2,
    "fallback_log_max_sigma": 5.0,
    "fallback_log_num_sigma": 8,
    "fallback_log_threshold_rel": 0.03,
    "fallback_min_distance": 8,
    "fallback_threshold": 200.0,
    "auto_switch_on_distortion": true
  },
  "dedup": {
    "enabled": true,
    "method": "kdtree",
    "neighbor_slices": 1,
    "r_xy_um": 6.0,
    "r_z_rule": "slice_spacing_um*0.5"
  },
  "outputs": {
    "leaf_csv": "outputs/cell_counts_leaf.csv",
    "hierarchy_csv": "outputs/cell_counts_hierarchy.csv",
    "qc_dir": "outputs/qc_overlays"
  }
}

